@inject AppLanguage Lang

@* Tells search engines where the same page exists in other languages. Place once on every page. *@
<HeadContent>
    <link rel="canonical" href="@Lang.AbsoluteUrlFor(Lang.Code)" />
    @foreach (var language in Languages.All)
    {
        <link rel="alternate" hreflang="@language.Code" href="@Lang.AbsoluteUrlFor(language.Code)" />
    }
    <link rel="alternate" hreflang="x-default" href="@Lang.AbsoluteUrlFor(Languages.Default)" />
</HeadContent>
