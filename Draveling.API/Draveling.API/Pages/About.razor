@page "/about"
@page "/hy/about"
@page "/ru/about"
@inject AppLanguage Lang
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["About_Title"]</PageTitle>
<HeadContent>
    <meta name="description" content="@L["About_MetaDescription"]" />
</HeadContent>
<AlternateLanguageLinks />

<article class="about">
    <header class="about-header">
        <h1>@L["About_Heading"]</h1>
        <p class="lead">@L["About_Lead"]</p>
    </header>

    <section class="about-section">
        <h2 class="h4">@L["About_OfferHeading"]</h2>
        <p>@L["About_OfferText"]</p>
    </section>

    <section class="about-section">
        <h2 class="h4">@L["About_HowHeading"]</h2>
        <p>@L["About_HowText"]</p>
    </section>

    <section class="about-section">
        <h2 class="h4">@L["About_EstimatesHeading"]</h2>
        <p>@L["About_EstimatesText"]</p>
    </section>

    <a class="btn btn-primary" href="@Lang.Href("trip-budget-calculator")">@L["Home_CalculatorLink"]</a>
</article>
