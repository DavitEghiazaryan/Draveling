@page "/"
@page "/hy"
@page "/ru"
@inject AppLanguage Lang
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["Home_Title"]</PageTitle>
<HeadContent>
    <meta name="description" content="@L["Home_MetaDescription"]" />
</HeadContent>
<AlternateLanguageLinks />

<section class="hero">
    <h1>@L["Home_Heading"]</h1>
    <p class="lead">@L["Home_Lead"]</p>
    <a class="btn btn-primary btn-lg" href="@Lang.Href("trip-budget-calculator")">@L["Home_CalculatorLink"]</a>
</section>
